// Copy to secrets.h (gitignored) and fill in.
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// mDNS name: the bridge answers on http://evo.local
#define BRIDGE_HOSTNAME "evo"

// Bluetooth MAC of the Timebox Evo, as shown by `bluetoothctl scan on`
// (the device is usually listed as "TimeBox-Evo-audio" or "TimeBox-Evo-light").
#define EVO_MAC "11:75:58:00:00:00"

// Shared secret the Claude Code hook sends in the X-Evo-Token header.
// Generate one with `openssl rand -hex 16` and put the same value in
// ~/.config/evo-bridge/token on the PC (see README).
#define BRIDGE_TOKEN "replace-with-openssl-rand-hex-16"

// Pairing PIN. Empty = 0000, which the Timebox Evo uses.
#define EVO_PIN ""
